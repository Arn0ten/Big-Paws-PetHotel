# Docker ignore file for Big-Paws Pet Boarding Application
# This file specifies which files and directories should be excluded from Docker builds

# Node.js dependencies and build files
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log

# Next.js build output
.next
out

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Version control
.git
.gitignore

# IDE and editor files
.idea
.vscode
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test coverage
coverage

# Logs
logs
*.log

# Temporary files
tmp
temp

# CONFIGURATION GUIDE:
# 1. Add any additional files or directories that should be excluded from Docker builds
# 2. This file helps keep your Docker images small and secure
# 3. Ensure sensitive files (like .env) are included here
# 4. Review this file when adding new development tools or build processes

