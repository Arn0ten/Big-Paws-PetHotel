# Exclude files and directories from Docker builds
# This keeps your Docker images smaller and more secure

# Version control
.git
.github
.gitignore

# Node.js
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log

# Next.js build output
.next
out

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage
.nyc_output

# IDE files
.idea
.vscode
*.swp
*.swo

# travis-ci
.travis.yml
/.travis.yml

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Temporary files
tmp
temp

# Build artifacts
dist
build

# CONFIGURATION GUIDE:
# 1. Add any other files or directories that should not be included in Docker images
# 2. Keep sensitive information out of your Docker images
# 3. This file helps make your Docker builds faster and more secure

